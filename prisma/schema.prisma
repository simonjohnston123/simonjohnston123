// PlacidCRM — multi-tenant CRM SaaS schema
// Agency (PlacidCRM) -> Locations / sub-accounts (each business) -> everything else.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN // platform owner (you)
  AGENCY_USER
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum LocationRole {
  ADMIN
  MEMBER
}

// The top-level tenant. Everything belongs to exactly one agency.
// PlacidCRM runs a single agency by default, but the model supports more.
model Agency {
  id                   String       @id @default(cuid())
  name                 String
  status               AgencyStatus @default(ACTIVE)
  plan                 String       @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  users                User[]
  locations            Location[]
}

// A sub-account = one business (Placid Storage Solutions, Placid Homestead, ...).
model Location {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name       String
  slug       String   @unique
  industry   String?
  timezone   String   @default("Australia/Brisbane")
  phone      String?
  email      String?
  website    String?
  addressLine String?
  city       String?
  state      String?
  postalCode String?
  country    String?  @default("Australia")
  taxId         String? // ABN / VAT / EIN / GST (primary, label depends on country)
  companyNumber String? // ACN / Company number / NZBN (secondary)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships   Membership[]
  contacts      Contact[]
  tags          Tag[]
  customFields  CustomField[]
  pipelines     Pipeline[]
  opportunities Opportunity[]
  conversations Conversation[]
  calendars     Calendar[]
  appointments  Appointment[]
  tasks         Task[]
  site          Site?
  workflows     Workflow[]
  connections   Connection[]
  orders        Order[]
  deliveryJobs  DeliveryJob[]
  storageSettings StorageSettings?
  storageProducts StorageProduct[]
  storageBookings StorageBooking[]
  storageWaitlist StorageWaitlist[]
  storageRequests StorageServiceRequest[]

  @@index([agencyId])
}

model User {
  id           String       @id @default(cuid())
  agencyId     String
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String       @unique
  name         String
  passwordHash String
  globalRole   GlobalRole   @default(AGENCY_USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  assignedTasks Task[]

  @@index([agencyId])
}

// Which users can access which sub-accounts, and with what role.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  role       LocationRole @default(ADMIN)
  createdAt  DateTime     @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// CRM — contacts, tags, custom fields
// ---------------------------------------------------------------------------

model Contact {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  firstName  String?
  lastName   String?
  email      String?
  phone      String?
  companyName String?
  source     String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tags          ContactTag[]
  fieldValues   CustomFieldValue[]
  opportunities Opportunity[]
  conversations Conversation[]
  appointments  Appointment[]
  tasks         Task[]
  orders        Order[]

  @@index([locationId])
  @@index([locationId, email])
}

// ---------------------------------------------------------------------------
// Tasks / follow-ups
// ---------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title      String
  notes      String?   @db.Text
  dueAt      DateTime?
  completed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([locationId])
  @@index([locationId, completed])
  @@index([contactId])
}

model Tag {
  id         String       @id @default(cuid())
  locationId String
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  color      String       @default("#337dff")
  contacts   ContactTag[]

  @@unique([locationId, name])
  @@index([locationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomField {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  key        String
  type       CustomFieldType   @default(TEXT)
  options    String?           // comma-separated for SELECT
  values     CustomFieldValue[]

  @@unique([locationId, key])
  @@index([locationId])
}

model CustomFieldValue {
  id       String      @id @default(cuid())
  fieldId  String
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contactId String
  contact  Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  value    String?

  @@unique([fieldId, contactId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Pipelines & opportunities
// ---------------------------------------------------------------------------

model Pipeline {
  id         String          @id @default(cuid())
  locationId String
  location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime        @default(now())
  stages     PipelineStage[]
  opportunities Opportunity[]

  @@index([locationId])
}

model PipelineStage {
  id         String        @id @default(cuid())
  pipelineId String
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int           @default(0)
  opportunities Opportunity[]

  @@index([pipelineId])
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

model Opportunity {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pipelineId String
  pipeline   Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String
  stage      PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  value      Float             @default(0)
  status     OpportunityStatus @default(OPEN)
  position   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([locationId])
  @@index([pipelineId])
  @@index([stageId])
}

// ---------------------------------------------------------------------------
// Conversations (unified inbox)
// ---------------------------------------------------------------------------

enum Channel {
  SMS
  EMAIL
  WHATSAPP
  WEBCHAT
  NOTE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

model Conversation {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel    Channel   @default(SMS)
  subject    String?
  lastMessageAt DateTime @default(now())
  unread     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@index([locationId])
  @@index([locationId, lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection @default(OUTBOUND)
  channel        Channel          @default(SMS)
  body           String           @db.Text
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Calendars & appointments
// ---------------------------------------------------------------------------

model Calendar {
  id         String        @id @default(cuid())
  locationId String
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  durationMinutes Int      @default(30)
  // Each calendar doubles as a bookable service / booking option.
  description String?      @db.Text
  price       Int?         // whole-dollar price for this service/booking option (optional)
  active      Boolean      @default(true)
  // Weekly availability: { "1": [["09:00","17:00"]], ... } keyed by weekday 0=Sun..6=Sat.
  availability     Json    @default("{}")
  bookingWindowDays Int    @default(14)
  createdAt  DateTime      @default(now())
  appointments Appointment[]

  @@unique([locationId, slug])
  @@index([locationId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  calendarId String
  calendar   Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?           @db.Text
  createdAt  DateTime          @default(now())

  @@index([locationId])
  @@index([locationId, startAt])
}

// ---------------------------------------------------------------------------
// Tenant websites (public marketing sites per sub-account)
// ---------------------------------------------------------------------------

model Site {
  id           String     @id @default(cuid())
  locationId   String     @unique
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  published    Boolean    @default(false)
  primaryColor String     @default("#1d5df5")
  logoText     String?
  tagline      String?
  customDomain String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pages        SitePage[]
}

model SitePage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  slug      String // "" = home page
  // Ordered list of content blocks stored as JSON.
  blocks    Json     @default("[]")
  isHome    Boolean  @default(false)
  position  Int      @default(0)
  seoTitle       String?
  seoDescription String?
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Automations / workflows  (GHL-style: a trigger fires a chain of actions)
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum TriggerType {
  CONTACT_CREATED
  TAG_ADDED
  OPPORTUNITY_CREATED
  FORM_SUBMITTED
  MANUAL
}

enum ActionType {
  SEND_EMAIL
  SEND_SMS
  ADD_TAG
  CREATE_TASK
  CREATE_NOTE
  WAIT
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Workflow {
  id            String         @id @default(cuid())
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   TriggerType    @default(MANUAL)
  triggerConfig Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         WorkflowStep[]
  runs          WorkflowRun[]

  @@index([locationId])
  @@index([locationId, status, triggerType])
}

model WorkflowStep {
  id         String     @id @default(cuid())
  workflowId String
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position   Int        @default(0)
  actionType ActionType
  config     Json       @default("{}")

  @@index([workflowId])
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  locationId String
  contactId  String?
  status     RunStatus         @default(RUNNING)
  trigger    String?
  context    Json              @default("{}")
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  steps      WorkflowRunStep[]

  @@index([workflowId])
  @@index([locationId])
}

model WorkflowRunStep {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position   Int         @default(0)
  actionType ActionType
  status     String
  detail     String?
  ranAt      DateTime    @default(now())

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Integrations — each sub-account connects its OWN channels (multi-tenant).
// Secrets are stored encrypted (AES-256-GCM) and never returned to the client.
// ---------------------------------------------------------------------------

enum ConnectionProvider {
  GMAIL
  OUTLOOK
  SMTP
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS
  WHATSAPP
  TWILIO
  STRIPE
  SQUARE
  SHOPIFY
  EBAY
  GOOGLE_CALENDAR
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

model Connection {
  id           String             @id @default(cuid())
  locationId   String
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider     ConnectionProvider
  status       ConnectionStatus   @default(CONNECTED)
  accountLabel String?            // e.g. connected email, page name, or phone number
  secretCipher String?            @db.Text // encrypted JSON blob of tokens/keys
  meta         Json               @default("{}") // non-secret display info
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([locationId, provider])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Orders — product orders and delivery jobs for a business.
// ---------------------------------------------------------------------------

enum OrderType {
  PRODUCT
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  locationId      String
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  number          Int         @default(0)
  type            OrderType   @default(PRODUCT)
  status          OrderStatus @default(NEW)
  items           Json        @default("[]") // [{ name, qty, price }]
  total           Float       @default(0)
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  notes           String?     @db.Text
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([locationId])
  @@index([locationId, status])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Placid Deliveries — a hybrid driver marketplace. Drivers are their OWN
// audience (separate accounts/session). Businesses post delivery jobs; jobs are
// SHARED (any approved driver) or OWN (a business's own drivers — later).
// ---------------------------------------------------------------------------

enum DriverStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum DeliveryStatus {
  POSTED
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DeliveryScope {
  OWN
  SHARED
}

model Driver {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  vehicle      String?
  status       DriverStatus  @default(APPROVED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         DeliveryJob[]
}

model DeliveryJob {
  id             String         @id @default(cuid())
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orderId        String?
  status         DeliveryStatus @default(POSTED)
  scope          DeliveryScope  @default(SHARED)
  driverId       String?
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  pickupAddress  String
  dropoffAddress String
  customerName   String?
  customerPhone  String?
  fee            Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  acceptedAt     DateTime?
  deliveredAt    DateTime?

  @@index([status])
  @@index([locationId])
  @@index([driverId])
}

// ---------------------------------------------------------------------------
// Storage module — Placid Storage's yard (bookings/inventory/PINs) built NATIVELY
// into the CRM, scoped to a Location. Ported from the standalone storage app so
// a storage sub-account is managed entirely inside PlacidCRM (no separate login).
// ---------------------------------------------------------------------------

enum StorageSpotType {
  CAR
  CONTAINER
}

enum StorageTerm {
  WEEKLY
  MONTHLY
}

enum StorageBookingStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  CANCELLED
  ENDED
  WAITLISTED
}

enum StorageRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model StorageSettings {
  id                 String   @id @default(cuid())
  locationId         String   @unique
  location           Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  siteAddress        String?
  carCapacity        Int      @default(0)
  containerCapacity  Int      @default(0)
  currency           String   @default("AUD")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StorageProduct {
  id                String          @id @default(cuid())
  locationId        String
  location          Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  spotType          StorageSpotType
  sizeLabel         String?
  priceMonthlyCents Int             @default(0)
  priceWeeklyCents  Int?
  active            Boolean         @default(true)
  sortOrder         Int             @default(0)
  bookings          StorageBooking[]

  @@unique([locationId, code])
  @@index([locationId])
}

model StorageBooking {
  id                String               @id @default(cuid())
  locationId        String
  location          Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ref               String               @unique
  contactId         String?
  productId         String?
  product           StorageProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  spotType          StorageSpotType
  term              StorageTerm          @default(MONTHLY)
  startDate         DateTime
  endDate           DateTime?
  openEnded         Boolean              @default(true)
  amountCents       Int                  @default(0)
  status            StorageBookingStatus @default(ACTIVE)
  pin               String?
  spotLabel         String?
  storedDescription String?
  vehicleMake       String?
  vehicleModel      String?
  vehicleRego       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([locationId])
  @@index([locationId, status])
}

model StorageWaitlist {
  id             String          @id @default(cuid())
  locationId     String
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  spotType       StorageSpotType
  status         String          @default("waiting")
  contactId      String?
  name           String
  email          String
  productName    String?
  requestedStart DateTime?
  createdAt      DateTime        @default(now())

  @@index([locationId])
}

model StorageServiceRequest {
  id          String               @id @default(cuid())
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookingRef  String?
  contactId   String?
  name        String
  email       String
  phone       String?
  category    String
  message     String               @db.Text
  status      StorageRequestStatus @default(OPEN)
  createdAt   DateTime             @default(now())

  @@index([locationId])
}
