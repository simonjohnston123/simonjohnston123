// PlacidCRM — multi-tenant CRM SaaS schema
// Agency (PlacidCRM) -> Locations / sub-accounts (each business) -> everything else.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

enum GlobalRole {
  SUPER_ADMIN // platform owner (you)
  AGENCY_USER
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
}

enum LocationRole {
  ADMIN
  MEMBER
}

// The top-level tenant. Everything belongs to exactly one agency.
// PlacidCRM runs a single agency by default, but the model supports more.
model Agency {
  id                   String       @id @default(cuid())
  name                 String
  status               AgencyStatus @default(ACTIVE)
  plan                 String       @default("free")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  users                User[]
  locations            Location[]
}

// A sub-account = one business (Placid Storage Solutions, Placid Homestead, ...).
model Location {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name       String
  slug       String   @unique
  industry   String?
  timezone   String   @default("Australia/Brisbane")
  phone      String?
  email      String?
  website    String?
  addressLine String?
  city       String?
  state      String?
  postalCode String?
  country    String?  @default("Australia")
  taxId         String? // ABN / VAT / EIN / GST (primary, label depends on country)
  companyNumber String? // ACN / Company number / NZBN (secondary)
  // Embedded Stripe Connect (white-label "Placid Connect payments"). The connected
  // account is created + onboarded via Stripe embedded components; we only cache
  // its id + capability flags. Charges route through it with a platform fee.
  stripeAccountId        String?
  stripeChargesEnabled   Boolean @default(false)
  stripeDetailsSubmitted Boolean @default(false)
  stripePayoutsEnabled   Boolean @default(false)
  // Auto-route new marketplace orders (eBay/Shopify) into this Success Track stage
  // when they sync. Null = don't route, orders just land on the Orders page.
  ordersPipelineId String?
  ordersStageId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships   Membership[]
  contacts      Contact[]
  tags          Tag[]
  customFields  CustomField[]
  pipelines     Pipeline[]
  opportunities Opportunity[]
  conversations Conversation[]
  calendars     Calendar[]
  appointments  Appointment[]
  tasks         Task[]
  site          Site?
  workflows     Workflow[]
  connections   Connection[]
  orders        Order[]
  deliveryJobs  DeliveryJob[]
  storageSettings StorageSettings?
  storageProducts StorageProduct[]
  storageBookings StorageBooking[]
  storageWaitlist StorageWaitlist[]
  storageRequests StorageServiceRequest[]
  homesteadRooms    HomesteadRoom[]
  homesteadBookings HomesteadBooking[]
  homesteadSettings HomesteadSettings?
  externalBusy      ExternalBusy[]
  forms             Form[]
  products          Product[]
  productCategories ProductCategory[]
  socialPosts       SocialPost[]
  mediaAssets       MediaAsset[]
  voiceAgent        VoiceAgent?
  callLogs          CallLog[]
  usageEvents       UsageEvent[]
  renderJobs        RenderJob[]
  inboxFolders      InboxFolder[]
  supplierOrders    SupplierOrder[]
  // Provider keys this business chose to use (set at onboarding) — drives which
  // integrations we surface first.
  wantedIntegrations Json @default("[]")

  @@index([agencyId])
}

model User {
  id           String       @id @default(cuid())
  agencyId     String
  agency       Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email        String       @unique
  name         String
  passwordHash String
  globalRole   GlobalRole   @default(AGENCY_USER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  assignedTasks Task[]

  @@index([agencyId])
}

// Which users can access which sub-accounts, and with what role.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  role       LocationRole @default(ADMIN)
  createdAt  DateTime     @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// CRM — contacts, tags, custom fields
// ---------------------------------------------------------------------------

model Contact {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  firstName  String?
  lastName   String?
  email      String?
  phone      String?
  companyName String?
  source     String?
  externalId String?  // social sender id (e.g. Facebook PSID) for dedupe
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tags          ContactTag[]
  fieldValues   CustomFieldValue[]
  opportunities Opportunity[]
  conversations Conversation[]
  appointments  Appointment[]
  tasks         Task[]
  orders        Order[]

  @@index([locationId])
  @@index([locationId, email])
  @@index([locationId, externalId])
}

// ---------------------------------------------------------------------------
// Tasks / follow-ups
// ---------------------------------------------------------------------------

model Task {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  title      String
  notes      String?   @db.Text
  dueAt      DateTime?
  completed  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([locationId])
  @@index([locationId, completed])
  @@index([contactId])
}

model Tag {
  id         String       @id @default(cuid())
  locationId String
  location   Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  color      String       @default("#337dff")
  contacts   ContactTag[]

  @@unique([locationId, name])
  @@index([locationId])
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

model CustomField {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  key        String
  type       CustomFieldType   @default(TEXT)
  options    String?           // comma-separated for SELECT
  values     CustomFieldValue[]

  @@unique([locationId, key])
  @@index([locationId])
}

model CustomFieldValue {
  id       String      @id @default(cuid())
  fieldId  String
  field    CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  contactId String
  contact  Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  value    String?

  @@unique([fieldId, contactId])
  @@index([contactId])
}

// ---------------------------------------------------------------------------
// Pipelines & opportunities
// ---------------------------------------------------------------------------

model Pipeline {
  id         String          @id @default(cuid())
  locationId String
  location   Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime        @default(now())
  stages     PipelineStage[]
  opportunities Opportunity[]

  @@index([locationId])
}

model PipelineStage {
  id         String        @id @default(cuid())
  pipelineId String
  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int           @default(0)
  opportunities Opportunity[]
  actions    StageAction[]

  @@index([pipelineId])
}

// Automations that fire when a deal lands in a stage — the "workflow lives in
// the Success Track" model. type ∈ SEND_EMAIL | SEND_SMS | ADD_TAG | CREATE_TASK.
model StageAction {
  id        String        @id @default(cuid())
  stageId   String
  stage     PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  type      String
  config    Json          @default("{}")
  position  Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([stageId])
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ABANDONED
}

model Opportunity {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  pipelineId String
  pipeline   Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stageId    String
  stage      PipelineStage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  value      Float             @default(0)
  status     OpportunityStatus @default(OPEN)
  position   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([locationId])
  @@index([pipelineId])
  @@index([stageId])
}

// ---------------------------------------------------------------------------
// Conversations (unified inbox)
// ---------------------------------------------------------------------------

enum Channel {
  SMS
  EMAIL
  WHATSAPP
  WEBCHAT
  NOTE
  FACEBOOK
  INSTAGRAM
  PHONE
  EBAY
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ---------------------------------------------------------------------------
// AI call centre — one AI receptionist per business. Inbound calls hit
// /api/voice/inbound, converse via the gather loop, and land in the inbox.
// ---------------------------------------------------------------------------

model VoiceAgent {
  id          String   @id @default(cuid())
  locationId  String   @unique
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  phoneNumber String?  @unique // the business's Twilio number, E.164
  enabled     Boolean  @default(true)
  greeting    String?  @db.Text // opening line; sensible default if empty
  hours       String?  // free text, e.g. "Mon–Fri 9am–5pm, Sat 9–12"
  knowledge   String?  @db.Text // FAQs / anything the AI should know
  transferTo  String?  // owner's mobile for live transfer, E.164
  voice       String   @default("Polly.Olivia-Neural") // AU neural voice
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One row per billable platform event (voice minute, SMS, reel render, …).
// Monthly rollup bills each business via the platform Stripe. Master vendor
// accounts are Placid's; clients only ever see these metered charges.
model UsageEvent {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       String   // voice_min | sms | reel | ...
  qty        Int      @default(1)
  unitCents  Int      // retail price per unit charged to the business
  totalCents Int
  ref        String?  // e.g. callSid, message id, render id
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([locationId, kind])
}

// AI marketing-video render jobs (Reel Studio). Rendered on Placid's own GPU
// video factory; each render is billed via UsageEvent (kind "reel").
model RenderJob {
  id           String   @id @default(cuid())
  locationId   String
  location     Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  productId    String?
  productName  String
  presenter    String   @default("dave") // dave | dick (voice locked to presenter)
  script       Json     // {overlay_title, rrp_line, now_line, ticker, images[], chunks[]}
  status       String   @default("QUEUED") // QUEUED | RENDERING | DONE | FAILED
  note         String?  // human-readable progress/errata
  mediaAssetId String?  // finished mp4 as a MediaAsset (attachable to posts)
  priceCents   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([locationId, createdAt])
  @@index([status])
}

model CallLog {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  callSid     String   @unique
  direction   String   @default("inbound")
  fromNumber  String
  toNumber    String
  status      String   @default("in-progress") // in-progress | completed | transferred | failed
  transcript  Json     @default("[]") // [{role:"caller"|"ai", text, at}]
  summary     String?  @db.Text
  contactId   String?
  durationSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
  @@index([locationId, createdAt])
}

model Conversation {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  channel    Channel   @default(SMS)
  subject    String?
  lastMessageAt DateTime @default(now())
  unread     Boolean   @default(false)
  starred    Boolean   @default(false)
  // Auto-detected "folder" — the source of the conversation (eBay, Temu, …),
  // derived from the sender for email. Null = General.
  sourceLabel String?
  // Marketplace thread linkage. For eBay: the listing the buyer is asking about
  // and their marketplace username — both are required to send the reply back,
  // since eBay masks the buyer's real email address.
  externalId   String?
  externalUser String?
  // AI-suggested reply awaiting a human to approve and send.
  draftReply   String?  @db.Text
  createdAt  DateTime  @default(now())
  messages   Message[]

  @@index([locationId])
  @@index([locationId, lastMessageAt])
  @@index([locationId, sourceLabel])
  @@index([locationId, externalId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection @default(OUTBOUND)
  channel        Channel          @default(SMS)
  body           String           @db.Text
  // Email receive: the RFC822 Message-ID (for dedup/threading) and the original
  // sent/received timestamp. Null for messages that originate inside the CRM.
  messageId      String?
  receivedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Calendars & appointments
// ---------------------------------------------------------------------------

model Calendar {
  id         String        @id @default(cuid())
  locationId String
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  durationMinutes Int      @default(30)
  // Each calendar doubles as a bookable service / booking option.
  description String?      @db.Text
  price       Int?         // whole-dollar price for this service/booking option (optional)
  active      Boolean      @default(true)
  // Mobile/on-site services: a fixed call-out fee, plus travel charged either
  // as a flat fee or per km beyond a free radius. All in cents.
  calloutFeeCents  Int?
  travelFeeCents   Int?    // flat travel fee
  travelPerKmCents Int?    // per-km rate beyond travelFreeKm
  travelFreeKm     Int?    // km included before per-km charging starts
  // Weekly availability: { "1": [["09:00","17:00"]], ... } keyed by weekday 0=Sun..6=Sat.
  availability     Json    @default("{}")
  bookingWindowDays Int    @default(14)
  // Per-service booking questions asked at booking time (rego, make/model, …).
  // Same shape as Form.fields: [{ key, label, type, required, options?, placeholder? }]
  intakeFields Json         @default("[]")
  createdAt  DateTime      @default(now())
  appointments Appointment[]

  @@unique([locationId, slug])
  @@index([locationId])
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(cuid())
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  calendarId String
  calendar   Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title      String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?           @db.Text
  // Google Calendar event id when this appointment has been pushed out (2-way sync).
  externalEventId String?
  createdAt  DateTime          @default(now())

  @@index([locationId])
  @@index([locationId, startAt])
}

// Busy blocks pulled IN from an external calendar (e.g. the operator's Google
// Calendar). These aren't Placid bookings — they exist only to stop the slot
// engine from offering times the operator is already committed elsewhere.
model ExternalBusy {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider   ConnectionProvider @default(GOOGLE_CALENDAR)
  externalId String   // event id in the source calendar
  startAt    DateTime
  endAt      DateTime
  summary    String?
  updatedAt  DateTime @updatedAt

  @@unique([locationId, provider, externalId])
  @@index([locationId, startAt])
}

// ---------------------------------------------------------------------------
// Products — a simple catalogue per business, shown at /shop/[slug].
// ---------------------------------------------------------------------------

// Business-defined product categories (create first, then assign products).
// Separate from `Product.category`, which holds the raw supplier department.
model ProductCategory {
  id         String    @id @default(cuid())
  locationId String
  location   Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  products   Product[]

  @@unique([locationId, slug])
  @@index([locationId])
}

model Product {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  categoryId  String?
  productCategory ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  price       Int?     // whole-dollar price (shop page; kept for back-compat)
  description String?  @db.Text
  imageUrl    String?
  images      Json     @default("[]") // gallery image URLs (supplier), first = primary
  colour      String?  // primary colour, where the supplier provides it
  active      Boolean  @default(true)
  position    Int      @default(0)
  // Catalogue fields — populated by marketplace import (Shopify/…).
  sku         String?
  category    String?  // Shopify product_type
  vendor      String?
  priceCents  Int?     // accurate price incl. cents
  costCents   Int?     // supplier/dropshipper cost per item (synced from Shopify unitCost)
  freightCents Int?    // per-item freight/shipping cost, where known
  inventory   Int?     // total stock across variants
  source      String?  // where it came from (Shopify/eBay/manual)
  externalId  String?  // provider product id (dedup)
  // The live eBay listing (item) number, recorded when we publish. Buyers must
  // be kept on eBay, so an answer that offers a product has to quote this.
  ebayItemId  String?
  // Fulfilment/shipping origin — drives the warehouse & dropshipper filters and
  // the geo-gate ("only market where it can ship"). From Shopify tags/metafields.
  supplier    String?  // dropshipper / supplier (e.g. Dropshipzone, CJ Dropshipping)
  warehouse   String?  // primary warehouse code (e.g. AU, US, CN)
  shipCountries Json    @default("[]") // ISO country codes this product can ship to
  tags        Json     @default("[]") // raw Shopify tags (channel eligibility etc.)
  // Which platforms this product should be listed on (keys: "shopify","ebay",
  // "placid_connect","facebook","tiktok"). Drives the outbound push + buy-where widget.
  channels    Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([locationId])
  @@index([locationId, category])
  @@index([locationId, warehouse])
  @@index([locationId, supplier])
  @@index([locationId, source, externalId])
  @@index([locationId, ebayItemId])
}

// ---------------------------------------------------------------------------
// Forms & Surveys — standalone, shareable, submissions feed Contacts + inbox.
// ---------------------------------------------------------------------------

enum FormType {
  FORM
  SURVEY
}

model Form {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name        String
  type        FormType @default(FORM)
  description String?  @db.Text // what it's for — also seeds AI generation
  // Field list: [{ key, label, type, required, options?, placeholder? }]
  fields      Json     @default("[]")
  submitLabel String   @default("Submit")
  thankYou    String   @default("Thanks — we'll be in touch shortly.") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  submissions FormSubmission[]

  @@index([locationId])
}

model FormSubmission {
  id         String   @id @default(cuid())
  formId     String
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  locationId String
  contactId  String?
  data       Json     // { fieldKey: value, ... }
  createdAt  DateTime @default(now())

  @@index([formId])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Tenant websites (public marketing sites per sub-account)
// ---------------------------------------------------------------------------

model Site {
  id           String     @id @default(cuid())
  locationId   String     @unique
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  published    Boolean    @default(false)
  primaryColor String     @default("#1d5df5")
  logoText     String?
  tagline      String?
  // Added by the parallel website-builder session (theme system) — kept in
  // sync here so cross-session deploys never try to drop it.
  theme        String     @default("light")
  customDomain String?    @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  pages        SitePage[]
}

model SitePage {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  slug      String // "" = home page
  // Ordered list of content blocks stored as JSON.
  blocks    Json     @default("[]")
  isHome    Boolean  @default(false)
  position  Int      @default(0)
  seoTitle       String?
  seoDescription String?
  updatedAt DateTime @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Automations / workflows  (GHL-style: a trigger fires a chain of actions)
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum TriggerType {
  CONTACT_CREATED
  TAG_ADDED
  OPPORTUNITY_CREATED
  FORM_SUBMITTED
  MANUAL
}

enum ActionType {
  SEND_EMAIL
  SEND_SMS
  ADD_TAG
  CREATE_TASK
  CREATE_NOTE
  WAIT
}

enum RunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model Workflow {
  id            String         @id @default(cuid())
  locationId    String
  location      Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        WorkflowStatus @default(DRAFT)
  triggerType   TriggerType    @default(MANUAL)
  triggerConfig Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         WorkflowStep[]
  runs          WorkflowRun[]

  @@index([locationId])
  @@index([locationId, status, triggerType])
}

model WorkflowStep {
  id         String     @id @default(cuid())
  workflowId String
  workflow   Workflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  position   Int        @default(0)
  actionType ActionType
  config     Json       @default("{}")

  @@index([workflowId])
}

model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  locationId String
  contactId  String?
  status     RunStatus         @default(RUNNING)
  trigger    String?
  context    Json              @default("{}")
  startedAt  DateTime          @default(now())
  finishedAt DateTime?
  steps      WorkflowRunStep[]

  @@index([workflowId])
  @@index([locationId])
}

model WorkflowRunStep {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  position   Int         @default(0)
  actionType ActionType
  status     String
  detail     String?
  ranAt      DateTime    @default(now())

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Integrations — each sub-account connects its OWN channels (multi-tenant).
// Secrets are stored encrypted (AES-256-GCM) and never returned to the client.
// ---------------------------------------------------------------------------

enum ConnectionProvider {
  GMAIL
  OUTLOOK
  SMTP
  FACEBOOK
  INSTAGRAM
  GOOGLE_BUSINESS
  WHATSAPP
  TWILIO
  STRIPE
  SQUARE
  SHOPIFY
  EBAY
  TIKTOK
  FACEBOOK_SHOP
  INSTAGRAM_SHOP
  WHATNOT
  GOOGLE_CALENDAR
  YOUTUBE
  SNAPCHAT
  // One Google connection per business covers every Google service they grant
  // (Gmail, Calendar, Business Profile, Merchant, Sheets, Drive, Contacts).
  GOOGLE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  PENDING
}

// User-defined inbox folders (per business). A folder auto-files a conversation
// when its rule matches — sender or subject contains `matchValue`. Businesses
// create/manage these themselves from the Inbox.
model InboxFolder {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name       String
  color      String   @default("#8e2de2")
  matchField String   @default("SENDER") // SENDER | SUBJECT
  matchValue String                       // case-insensitive substring to match
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([locationId])
}

// Platform-wide settings (encrypted). Lets the super-admin set secrets like the
// platform Stripe keys from the admin UI instead of the server .env.
model Setting {
  key         String   @id
  valueCipher String?  @db.Text
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Social poster — one composed post fanned out to the selected networks, now
// or on a schedule. `results` records the per-network outcome.
// ---------------------------------------------------------------------------

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIAL
  FAILED
}

model SocialPost {
  id          String           @id @default(cuid())
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  body        String           @db.Text
  mediaUrls   Json             @default("[]") // absolute URLs (uploads or external)
  mediaKind   String?          // "image" | "video" (all media in one post share a kind)
  networks    Json             @default("[]") // e.g. ["facebook","instagram","youtube"]
  options     Json             @default("{}") // per-network config, e.g. {facebookPageIds:[...]}
  results     Json             @default("{}") // per-network {ok, id?, error?, at}
  scheduledAt DateTime?
  status      SocialPostStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([locationId])
  @@index([status, scheduledAt])
}

// Uploaded images/videos for social posts (stored on the uploads volume and
// served publicly via /api/media/f/<id> so networks can fetch them).
model MediaAsset {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  kind       String   // image | video
  filename   String
  mime       String
  sizeBytes  Int
  path       String   // absolute path on the uploads volume
  createdAt  DateTime @default(now())

  @@index([locationId])
}

model Connection {
  id           String             @id @default(cuid())
  locationId   String
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  provider     ConnectionProvider
  status       ConnectionStatus   @default(CONNECTED)
  accountLabel String?            // e.g. connected email, page name, or phone number
  secretCipher String?            @db.Text // encrypted JSON blob of tokens/keys
  meta         Json               @default("{}") // non-secret display info
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([locationId, provider])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Orders — product orders and delivery jobs for a business.
// ---------------------------------------------------------------------------

enum OrderType {
  PRODUCT
  DELIVERY
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  locationId      String
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  number          Int         @default(0)
  type            OrderType   @default(PRODUCT)
  status          OrderStatus @default(NEW)
  items           Json        @default("[]") // [{ name, qty, price }]
  total           Float       @default(0)
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  notes           String?     @db.Text
  // Where the order came from (Shopify/eBay/…) + the external id for dedup.
  source          String?
  externalId      String?
  // When the order was actually placed on the marketplace (eBay creationDate /
  // Shopify created_at). Null for manual orders. createdAt is our import time.
  placedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  supplierOrders  SupplierOrder[]

  @@index([locationId])
  @@index([locationId, status])
  @@index([contactId])
  @@index([locationId, source, externalId])
  @@index([locationId, placedAt])
}

enum SupplierOrderStatus {
  TO_PLACE
  PLACED
  SHIPPED
  FAILED
  CANCELLED
}

/// One purchase from one supplier, covering the lines of a customer order that
/// that supplier fulfils. A single order can split across suppliers, so this is
/// deliberately separate from Order rather than a status on it — it is what the
/// fulfilment desk works from, replacing the per-supplier CSVs.
model SupplierOrder {
  id          String              @id @default(cuid())
  locationId  String
  location    Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier    String
  status      SupplierOrderStatus @default(TO_PLACE)
  /// [{ sku, name, qty, costCents, productId, warehouse }]
  items       Json                @default("[]")
  costCents   Int?
  /// The supplier's own order reference, once placed.
  supplierRef String?
  tracking    String?
  carrier     String?
  error       String?             @db.Text
  placedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([orderId, supplier])
  @@index([locationId, status])
  @@index([locationId, supplier])
}

// ---------------------------------------------------------------------------
// Placid Deliveries — a hybrid driver marketplace. Drivers are their OWN
// audience (separate accounts/session). Businesses post delivery jobs; jobs are
// SHARED (any approved driver) or OWN (a business's own drivers — later).
// ---------------------------------------------------------------------------

enum DriverStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum DeliveryStatus {
  POSTED
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum DeliveryScope {
  OWN
  SHARED
}

model Driver {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  vehicle      String?
  status       DriverStatus  @default(APPROVED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  jobs         DeliveryJob[]
}

model DeliveryJob {
  id             String         @id @default(cuid())
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  orderId        String?
  status         DeliveryStatus @default(POSTED)
  scope          DeliveryScope  @default(SHARED)
  driverId       String?
  driver         Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  pickupAddress  String
  dropoffAddress String
  customerName   String?
  customerPhone  String?
  fee            Float          @default(0)
  notes          String?
  createdAt      DateTime       @default(now())
  acceptedAt     DateTime?
  deliveredAt    DateTime?

  @@index([status])
  @@index([locationId])
  @@index([driverId])
}

// ---------------------------------------------------------------------------
// Storage module — Placid Storage's yard (bookings/inventory/PINs) built NATIVELY
// into the CRM, scoped to a Location. Ported from the standalone storage app so
// a storage sub-account is managed entirely inside PlacidCRM (no separate login).
// ---------------------------------------------------------------------------

enum StorageSpotType {
  CAR
  CONTAINER
}

enum StorageTerm {
  WEEKLY
  MONTHLY
}

enum StorageBookingStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
  CANCELLED
  ENDED
  WAITLISTED
}

enum StorageRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model StorageSettings {
  id                 String   @id @default(cuid())
  locationId         String   @unique
  location           Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  siteAddress        String?
  carCapacity        Int      @default(0)
  containerCapacity  Int      @default(0)
  currency           String   @default("AUD")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StorageProduct {
  id                String          @id @default(cuid())
  locationId        String
  location          Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  code              String
  name              String
  spotType          StorageSpotType
  sizeLabel         String?
  priceMonthlyCents Int             @default(0)
  priceWeeklyCents  Int?
  active            Boolean         @default(true)
  sortOrder         Int             @default(0)
  bookings          StorageBooking[]

  @@unique([locationId, code])
  @@index([locationId])
}

model StorageBooking {
  id                String               @id @default(cuid())
  locationId        String
  location          Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ref               String               @unique
  contactId         String?
  productId         String?
  product           StorageProduct?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  spotType          StorageSpotType
  term              StorageTerm          @default(MONTHLY)
  startDate         DateTime
  endDate           DateTime?
  openEnded         Boolean              @default(true)
  amountCents       Int                  @default(0)
  status            StorageBookingStatus @default(ACTIVE)
  pin               String?
  spotLabel         String?
  storedDescription String?
  vehicleMake       String?
  vehicleModel      String?
  vehicleRego       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([locationId])
  @@index([locationId, status])
}

model StorageWaitlist {
  id             String          @id @default(cuid())
  locationId     String
  location       Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  spotType       StorageSpotType
  status         String          @default("waiting")
  contactId      String?
  name           String
  email          String
  productName    String?
  requestedStart DateTime?
  createdAt      DateTime        @default(now())

  @@index([locationId])
}

model StorageServiceRequest {
  id          String               @id @default(cuid())
  locationId  String
  location    Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  bookingRef  String?
  contactId   String?
  name        String
  email       String
  phone       String?
  category    String
  message     String               @db.Text
  status      StorageRequestStatus @default(OPEN)
  createdAt   DateTime             @default(now())

  @@index([locationId])
}

// ===== Placid Connect — native social platform (replaces the OSSN site) =====
model ConnectMember {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  handle       String           @unique
  avatarUrl    String?
  bio          String?          @db.Text
  createdAt    DateTime         @default(now())
  posts        ConnectPost[]
  comments     ConnectComment[]
  likes        ConnectLike[]
  following    ConnectFriend[]  @relation("follower")
  followers    ConnectFriend[]  @relation("following")
  listings     ConnectListing[]
  ownedGroups      ConnectGroup[]       @relation("groupOwner")
  groupMemberships ConnectGroupMember[]

  @@index([handle])
}

model ConnectGroup {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?             @db.Text
  coverColor  String?             // brand tint for the header
  ownerId     String
  owner       ConnectMember       @relation("groupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  members     ConnectGroupMember[]
  posts       ConnectPost[]
}

model ConnectGroupMember {
  id        String        @id @default(cuid())
  groupId   String
  group     ConnectGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId  String
  member    ConnectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
}

enum ConnectListingStatus {
  ACTIVE
  SOLD
}

// ---- Listing Tool (multi-marketplace listing optimiser) --------------------
enum Marketplace {
  PLACID_CONNECT
  EBAY
  AMAZON
  TIKTOK
  GOOGLE
  FACEBOOK
  TEMU
}

enum ListingBatchStatus {
  DRAFT
  OPTIMISED
  PUBLISHED
  PARTIAL
}

enum ListingAiStatus {
  UNOPTIMISED
  OPTIMISING
  OPTIMISED
  FAILED
}

// A saved, named group of products to re-list as a set.
model Collection {
  id          String   @id @default(cuid())
  locationId  String
  name        String
  description String?
  rule        Json     @default("{}") // saved product filter
  productIds  Json     @default("[]") // explicit membership
  createdAt   DateTime @default(now())

  @@index([locationId])
}

// One run of the Listing Tool: products being prepared for one marketplace.
model ListingBatch {
  id          String             @id @default(cuid())
  locationId  String
  name        String
  marketplace Marketplace
  status      ListingBatchStatus @default(DRAFT)
  createdAt   DateTime           @default(now())
  items       ListingItem[]

  @@index([locationId])
  @@index([locationId, marketplace])
}

// One product inside a batch, holding the marketplace-specific fields.
model ListingItem {
  id            String          @id @default(cuid())
  batchId       String
  batch         ListingBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  productId     String
  fields        Json            @default("{}") // marketplace-shaped fields
  aiStatus      ListingAiStatus @default(UNOPTIMISED)
  validation    Json            @default("[]") // rule violations
  publishStatus String? // null | PUBLISHED | FAILED
  externalId    String?
  createdAt     DateTime        @default(now())

  @@index([batchId])
}

// Placid Connect marketplace listing (Facebook Marketplace-style).
model ConnectListing {
  id          String                @id @default(cuid())
  sellerId    String
  seller      ConnectMember         @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  description String                @db.Text
  price       Int                   @default(0) // whole dollars; 0 = Free
  category    String
  condition   String?
  location    String?
  imageUrl    String?
  status      ConnectListingStatus  @default(ACTIVE)
  createdAt   DateTime              @default(now())

  @@index([category])
  @@index([status, createdAt])
}

model ConnectPost {
  id         String           @id @default(cuid())
  authorId   String
  author     ConnectMember    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  groupId    String?
  group      ConnectGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  body       String           @db.Text
  bg         String?          // OssnPostBackground: a colour/gradient token
  imageUrl   String?
  createdAt  DateTime         @default(now())
  comments   ConnectComment[]
  likes      ConnectLike[]

  @@index([createdAt])
  @@index([authorId])
  @@index([groupId])
}

model ConnectComment {
  id        String        @id @default(cuid())
  postId    String
  post      ConnectPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    ConnectMember @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  createdAt DateTime      @default(now())

  @@index([postId])
}

model ConnectLike {
  id        String        @id @default(cuid())
  postId    String
  post      ConnectPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  memberId  String
  member    ConnectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, memberId])
}

model ConnectFriend {
  id          String        @id @default(cuid())
  followerId  String
  follower    ConnectMember @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   ConnectMember @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([followerId, followingId])
}

// ===== Placid Homestead — short-term accommodation (rooms, weekly rental) =====
enum HomesteadBookingStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

model HomesteadRoom {
  id          String            @id @default(cuid())
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name        String
  description String?           @db.Text
  weeklyPrice Int               @default(0) // AUD/week
  imageUrl    String?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  bookings    HomesteadBooking[]

  @@index([locationId])
}

model HomesteadBooking {
  id               String                 @id @default(cuid())
  locationId       String
  location         Location               @relation(fields: [locationId], references: [id], onDelete: Cascade)
  roomId           String?
  room             HomesteadRoom?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestName        String
  guestEmail       String
  guestPhone       String?
  startDate        DateTime
  weeklyPrice      Int                    @default(0)
  status           HomesteadBookingStatus @default(PENDING)
  contractAccepted Boolean                @default(false)
  signature        String?
  stripeSubId      String?
  createdAt        DateTime               @default(now())

  @@index([locationId])
  @@index([locationId, status])
}

model HomesteadSettings {
  id               String   @id @default(cuid())
  locationId       String   @unique
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  houseRules       String?  @db.Text
  welcomeInfo      String?  @db.Text // arrival: entry, parking, checkout
  contractText     String?  @db.Text
  bookingWindowDays Int     @default(21) // can book up to N days ahead
  depositWeeks     Int      @default(1)  // weeks charged upfront
}
