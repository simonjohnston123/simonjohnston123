# ---------------------------------------------------------------------------
# PlacidCRM environment configuration
# Copy to `.env` (local dev) or set these on your DigitalOcean server.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# For docker-compose the host is the service name `db`.
DATABASE_URL="postgresql://placid:placid@localhost:5432/placidcrm?schema=public"

# Secret used to sign session JWTs. Generate a strong random value:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# The primary URL the app is served from.
APP_URL="http://localhost:3000"

# The apex domain the platform runs on. Used to distinguish the admin app
# from tenant public sites when custom domains / subdomains are wired up.
ROOT_DOMAIN="placidcrm.com"

# Node environment
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Integration OAuth apps (optional). A provider stays "Coming soon" in the
# Integrations tab until its app credentials are present here.
# ---------------------------------------------------------------------------

# Google Cloud OAuth client — shared by Google Calendar (and later Gmail /
# Google Business). Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {APP_URL}/api/integrations/google_calendar/callback
# Required API: Google Calendar API. Scopes: calendar.events, openid, email.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta (Facebook/Instagram) app — shared by both Meta providers.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Square OAuth app — lets each business connect their own Square by signing in
# (no manual keys). Create at https://developer.squareup.com/apps
# Redirect URL to add in the Square app: {APP_URL}/api/integrations/square/callback
# Set SQUARE_ENV=sandbox while testing; leave unset (production) when live.
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENV=""

# Optional dedicated key for encrypting stored integration secrets at rest.
# Falls back to AUTH_SECRET if unset.
APP_ENCRYPTION_KEY=""
