# ---------------------------------------------------------------------------
# PlacidCRM environment configuration
# Copy to `.env` (local dev) or set these on your DigitalOcean server.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# For docker-compose the host is the service name `db`.
DATABASE_URL="postgresql://placid:placid@localhost:5432/placidcrm?schema=public"

# Secret used to sign session JWTs. Generate a strong random value:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# The primary URL the app is served from.
APP_URL="http://localhost:3000"

# The apex domain the platform runs on. Used to distinguish the admin app
# from tenant public sites when custom domains / subdomains are wired up.
ROOT_DOMAIN="placidcrm.com"

# Node environment
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Integration OAuth apps (optional). A provider stays "Coming soon" in the
# Integrations tab until its app credentials are present here.
# ---------------------------------------------------------------------------

# Google Cloud OAuth client — shared by Google Calendar (and later Gmail /
# Google Business). Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {APP_URL}/api/integrations/google_calendar/callback
# Required API: Google Calendar API. Scopes: calendar.events, openid, email.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta (Facebook/Instagram) app — shared by both Meta providers.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Square OAuth app — lets each business connect their own Square by signing in
# (no manual keys). Create at https://developer.squareup.com/apps
# Redirect URL to add in the Square app: {APP_URL}/api/integrations/square/callback
# Set SQUARE_ENV=sandbox while testing; leave unset (production) when live.
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_ENV=""

# Stripe Connect — embedded, white-label "Placid Connect payments".
# Placid Connect creates a connected account per business and drops Stripe's
# embedded onboarding component (themed as Placid) inside the Payments tab —
# the business never sees Stripe branding. Charges route through the connected
# account with a PLATFORM_FEE_PERCENT application fee to Placid Connect.
#   STRIPE_SECRET_KEY      platform secret key (sk_live_… / rk_live_…) — server only
#   STRIPE_PUBLISHABLE_KEY platform publishable key (pk_live_…) — safe in the browser
#   PLATFORM_FEE_PERCENT   % Placid Connect adds on top of each charge (default 2)
# Both keys come from the Placid Connect platform account:
#   dashboard.stripe.com → Developers → API keys
# STRIPE_CONNECT_CLIENT_ID (ca_…) is only needed for the older OAuth flow and is
# optional now that onboarding is embedded.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
PLATFORM_FEE_PERCENT="2"
STRIPE_CONNECT_CLIENT_ID=""

# eBay OAuth — create at https://developer.ebay.com/my/keys. EBAY_RUNAME is the
# Redirect URL name (RuName) whose "Your auth accepted URL" is set to
# {APP_URL}/api/integrations/ebay/callback in the eBay dev portal.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""
EBAY_RUNAME=""

# TikTok Shop (Partner Center) — app key/secret + the app's service id.
# Redirect URL in the app: {APP_URL}/api/integrations/tiktok/callback
TIKTOK_APP_KEY=""
TIKTOK_APP_SECRET=""
TIKTOK_SERVICE_ID=""

# Inbound email → Conversations. Point an inbound provider's webhook at
# {APP_URL}/api/inbound/email. Resend uses Svix signatures (RESEND_WEBHOOK_SECRET);
# SendGrid Inbound Parse posts a form — secure it by adding ?token=INBOUND_TOKEN
# to the webhook URL. Set whichever you use.
RESEND_WEBHOOK_SECRET=""
INBOUND_TOKEN=""
INBOUND_DOMAIN="inbox.placid.group"

# Optional dedicated key for encrypting stored integration secrets at rest.
# Falls back to AUTH_SECRET if unset.
APP_ENCRYPTION_KEY=""
